# Django secret key (REQUIRED in production)
# Generate your own unique key for deployments.
SECRET_KEY=changeme-in-production

# Debug mode: "True" or "False"
DEBUG=True

# Comma-separated list of allowed hosts (no spaces).
# Example: .kavia.ai,localhost,127.0.0.1
ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1,testserver

# Comma-separated list of allowed origins for CORS.
# The React frontend runs on http://localhost:3000 by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL database configuration for inventario_db
# These values should correspond to the inventario_db container.
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_HOST=localhost
DB_PORT=5000
