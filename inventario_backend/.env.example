# Example environment configuration for the inventario_backend Django service.
#
# NOTE: This file is for documentation only. Do NOT commit real secrets.
# The actual .env file will be managed by the orchestration environment.

# -----------------------------------------------------------------------------
# Django core settings
# -----------------------------------------------------------------------------
# SECRET_KEY must be provided in production. Use a long, random string.
SECRET_KEY=replace-with-a-secure-random-secret-key

# Debug mode: set to "False" in production.
DEBUG=True

# Comma-separated list of allowed hosts (e.g. "localhost,127.0.0.1,example.com")
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: CORS allowed origins for the frontend.
# Example: "http://localhost:3000,https://frontend.example.com"
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL database settings (provided by inventario_db container)
# -----------------------------------------------------------------------------
# Primary configuration: these variables are expected to be set by the platform.
# They are used by Django via config.settings.DATABASES.
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_HOST=localhost
POSTGRES_PORT=5000

# Optional: full PostgreSQL URL used mainly for direct psql access in tools.
# Example: postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# -----------------------------------------------------------------------------
# Legacy / fallback variables (kept for compatibility)
# -----------------------------------------------------------------------------
# If POSTGRES_* variables are not set, the following will be used as a fallback.
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_HOST=localhost
DB_PORT=5000
